# Copy this file to `.env` and fill in the values. Never commit `.env`.

# PostgreSQL (Postgres.app, local). Default works without changes.
DATABASE_URL=postgresql+psycopg://localhost:5432/diploma

# Signs login tokens. Generate one with:
#   uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Next.js dev server allowed to call the API
FRONTEND_ORIGIN=http://localhost:3000

# Course materials (optional — defaults shown)
# UPLOAD_DIR=data/uploads
# MAX_UPLOAD_MB=50

# LLM provider for the chat step (gemini | ollama | claude)
LLM_PROVIDER=gemini
# Free key: https://aistudio.google.com → Get API key
GEMINI_API_KEY=
# Model names as listed in Google AI Studio. The fallback is used when the main one is busy (503).
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
